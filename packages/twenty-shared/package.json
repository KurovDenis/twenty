{
  "name": "twenty-shared",
  "main": "dist/twenty-shared.cjs.js",
  "module": "dist/twenty-shared.esm.js",
  "types": "dist/twenty-shared.cjs.d.ts",
  "exports": {
    ".": {
      "types": "./dist/twenty-shared.cjs.d.ts",
      "import": "./dist/twenty-shared.esm.js",
      "require": "./dist/twenty-shared.cjs.js"
    },
    "./constants": {
      "types": "./dist/declarations/src/constants/index.d.ts",
      "import": "./dist/constants.esm.js",
      "require": "./dist/constants.cjs.js"
    },
    "./langgraph": {
      "types": "./dist/declarations/src/langgraph/index.d.ts",
      "import": "./dist/langgraph.esm.js",
      "require": "./dist/langgraph.cjs.js"
    },
    "./testing": {
      "types": "./dist/declarations/src/testing/index.d.ts",
      "import": "./dist/testing.esm.js",
      "require": "./dist/testing.cjs.js"
    },
    "./translations": {
      "types": "./dist/declarations/src/translations/index.d.ts",
      "import": "./dist/translations.esm.js",
      "require": "./dist/translations.cjs.js"
    },
    "./types": {
      "types": "./dist/declarations/src/types/index.d.ts",
      "import": "./dist/types.esm.js",
      "require": "./dist/types.cjs.js"
    },
    "./utils": {
      "types": "./dist/declarations/src/utils/index.d.ts",
      "import": "./dist/utils.esm.js",
      "require": "./dist/utils.cjs.js"
    },
    "./workflow": {
      "types": "./dist/declarations/src/workflow/index.d.ts",
      "import": "./dist/workflow.esm.js",
      "require": "./dist/workflow.cjs.js"
    },
    "./workspace": {
      "types": "./dist/declarations/src/workspace/index.d.ts",
      "import": "./dist/workspace.esm.js",
      "require": "./dist/workspace.cjs.js"
    }
  },
  "license": "AGPL-3.0",
  "scripts": {
    "build": "preconstruct build && node scripts/copy-package-json.js"
  },
  "engines": {
    "node": "^24.5.0",
    "npm": "please-use-yarn",
    "yarn": "^4.0.2"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-typescript": "^7.27.1",
    "@preconstruct/cli": "^2.8.12",
    "@prettier/sync": "^0.5.2",
    "@types/babel__preset-env": "^7",
    "@types/handlebars": "^4.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "glob": "^11.0.1",
    "tsx": "^4.19.3"
  },
  "dependencies": {
    "@sniptt/guards": "^0.2.0",
    "handlebars": "^4.7.8",
    "libphonenumber-js": "^1.10.26",
    "zod": "3.23.8"
  },
  "preconstruct": {
    "tsconfig": "tsconfig.lib.json",
    "entrypoints": [
      "./index.ts",
      "./constants/index.ts",
      "./langgraph/index.ts",
      "./testing/index.ts",
      "./translations/index.ts",
      "./types/index.ts",
      "./utils/index.ts",
      "./workflow/index.ts",
      "./workspace/index.ts"
    ]
  },
  "files": [
    "dist",
    "constants",
    "langgraph",
    "testing",
    "translations",
    "types",
    "utils",
    "workflow",
    "workspace"
  ]
}
