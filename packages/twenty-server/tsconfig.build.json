{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "moduleResolution": "node",
    "baseUrl": ".",
    "outDir": "./dist",
    "paths": {
      "src/*": ["./src/*"],
      "@twenty/shared": ["../twenty-shared/dist"],
      "@twenty/shared/*": ["../twenty-shared/dist/*"]
    },
    "types": ["node"]
  },
  "exclude": ["node_modules", "dist", "test", "**/*spec.ts"]
}
